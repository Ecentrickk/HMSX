{
  "name": "h1ms",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "release:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1 -BundleNode",
    "prod:start": "npx pm2 start ecosystem.config.js",
    "prod:stop": "npx pm2 stop ecosystem.config.js",
    "prod:restart": "npx pm2 restart ecosystem.config.js",
    "pdf:worker": "tsx src/server/workers/pdfExportSync.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.6.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/supabase-js": "^2.45.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "framer-motion": "^11.11.0",
    "git": "^0.1.5",
    "next": "^14.2.15",
    "next-auth": "^5.0.0-beta.25",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.8.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.15",
    "prisma": "^6.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
